<?xml version="1.0" encoding="utf-8"?>
<!-- PLACEHOLDER: real private NuGet feed URL + credentials go here.
     %VAR% is expanded by the NuGet client from the job's environment, so
     credentials should come from masked/protected CI/CD variables, never
     literals here. `dotnet restore`/`nuget restore` auto-discover
     nuget.config by walking up from the working directory -- no extra flag
     needed in the pipeline script for this one. -->
<configuration>
  <packageSources>
    <clear />
    <add key="TODO" value="https://TODO/nuget/v3/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <TODO>
      <add key="Username" value="%NUGET_USER%" />
      <add key="ClearTextPassword" value="%NUGET_PASSWORD%" />
    </TODO>
  </packageSourceCredentials>
</configuration>
