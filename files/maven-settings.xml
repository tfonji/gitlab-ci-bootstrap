<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
          http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <!--
        Maven Settings for Artifactory
        This file is part of source code with placeholders for credentials.
        Credentials are injected at runtime from CI/CD variables or local environment.
    -->
    <servers>
        <!-- Artifactory Release Repository -->
        <server>
            <id>artifactory-release</id>
            <username>${env.ARTIFACTORY_USER}</username>
            <password>${env.ARTIFACTORY_PASSWORD}</password>
        </server>
        <!-- Artifactory Snapshot Repository -->
        <server>
            <id>artifactory-snapshot</id>
            <username>${env.ARTIFACTORY_USER}</username>
            <password>${env.ARTIFACTORY_PASSWORD}</password>
        </server>
    </servers>
</settings>
